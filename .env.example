# .env.example
# Copy this to .env.local and fill in your values

# ═══════════════════════════════════════════════════════════════════════
# REQUIRED — Version 1
# ═══════════════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Railway, or local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/scriptovernovel"

# ─── NextAuth ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-here"
# Set to your production URL on Vercel (e.g., https://scriptovernovel.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# ─── App URL ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Timeline / Events pins on the About page use OpenStreetMap tiles via
# Leaflet — no API key, no billing account, nothing to configure here.

# ─── API Key (optional) ────────────────────────────────────────────────
# Enables X-API-Key header auth on all admin endpoints (useful for
# scripts, CI, and the /admin/api-docs Swagger UI "Authorize" button).
# Leave unset to disable key-based auth entirely.
# Generate with: openssl rand -hex 32
API_SECRET_KEY=""

# ─── Admin OAuth sign-in (Google / Facebook) ──────────────────────────
# Optional — the admin login always works with email+password even if
# these are unset. When set, only an email that already belongs to an
# ADMIN user in the database can sign in this way (see lib/auth.ts's
# `signIn` callback) — it never creates a new account.
#
# Register the app and add this EXACT redirect URI (swap in NEXTAUTH_URL
# above for production):
#   Google:   {NEXTAUTH_URL}/api/auth/callback/google
#             → console.cloud.google.com → APIs & Services → Credentials
#   Facebook: {NEXTAUTH_URL}/api/auth/callback/facebook
#             → developers.facebook.com → your app → Facebook Login → Settings
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ═══════════════════════════════════════════════════════════════════════
# OPTIONAL — Version 2 (Payment & E-Commerce)
# ═══════════════════════════════════════════════════════════════════════

# ─── PayMongo ──────────────────────────────────────────────────────────
# Get from: https://dashboard.paymongo.com/developers
# Not required for V1 — only needed when enabling Shop/Checkout
PAYMONGO_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
PAYMONGO_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
PAYMONGO_WEBHOOK_SECRET="whsk_xxxxxxxxxxxxxxxxxxxx"

# Optional — comma-separated list of checkout payment methods to offer
# (lib/paymongo.ts). Defaults to "gcash,card,qrph" if unset — keep this in
# sync with whatever is actually activated in the PayMongo Dashboard under
# Settings > Payment Methods. Any value not in the code's allowlist is
# dropped (logged as a warning), so a typo here can't reach the PayMongo
# API — but an activated-sounding value that isn't actually turned on in
# the Dashboard still isn't safe: it passes the code's allowlist fine, and
# only then fails at PayMongo's end, taking the ENTIRE checkout session
# down with it (not just that one method). Add "paymaya" (Maya), "grab_pay"
# (GrabPay), "billease", "dob" (BPI/RCBC online banking), or "dob_ubp"
# (UnionBank) here ONLY after confirming each is activated in the Dashboard.
PAYMONGO_PAYMENT_METHODS="gcash,card,qrph"

# ─── Media storage: Cloudflare R2 ──────────────────────────────────────
# Every upload (artwork images, .glb props, audio, video) lives in one R2
# bucket. Supabase is Postgres only — none of its Storage keys are needed any
# more. See Docs/Media_Storage_R2.md.
#
# All five are server-only. The browser never holds a credential: the two
# uploads too large to proxy (.glb, audio) get a short-lived presigned PUT
# from the server instead (lib/storage/r2.ts). Set the same five in Vercel.
#
# Account ID:      R2 overview page (or the dashboard URL)
# Access key pair: R2 > Manage R2 API Tokens > Create — Object Read & Write,
#                  scoped to this one bucket. The secret is shown once.
# Public URL:      the origin media is served from, no trailing slash — a
#                  custom domain connected to the bucket (production), or the
#                  bucket's Public Development URL (https://pub-….r2.dev;
#                  rate-limited, fine for a low-traffic site). Every media
#                  URL stored in the database starts with this, so changing
#                  it later means re-running the URL rewrite.
R2_ACCOUNT_ID="…32 hex chars…"
R2_ACCESS_KEY_ID="…"
R2_SECRET_ACCESS_KEY="…"
R2_BUCKET="scriptovernovel-music-website"
R2_PUBLIC_URL="https://media.example.com"

# ─── Google reCAPTCHA v3 ───────────────────────────────────────────────
# Get from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Le..."
RECAPTCHA_SECRET_KEY="6Le..."

# ─── Gmail SMTP (Email) ────────────────────────────────────────────────
# Use your Gmail address and an App Password (not your real Gmail password)
# How to get App Password: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional — BCC'd on every password-reset email (lib/mail.ts). Defaults to
# jryan.briz@gmail.com if unset.
PASSWORD_RESET_BCC_EMAIL="jryan.briz@gmail.com"

# Optional — where "a visitor unlocked a mini-game reward" alerts are sent
# (lib/minigames/notify.ts). Falls back to GMAIL_USER.
# With no mail configured at all, claims are still recorded and visible in
# Admin → Settings → Mini Games; only the alert email is skipped.
MINIGAME_NOTIFY_EMAIL="jryan.briz@gmail.com"

# Optional — where "new order paid" alerts are sent (lib/mail.ts). Defaults
# to GMAIL_USER (the shop's own inbox) if unset.
ORDER_ALERT_EMAIL="kylamarie.zuniga@gmail.com"

# ─── Vercel Web Analytics ──────────────────────────────────────────────
# Optional — powers the "Website Analytics" section in Admin → Dashboard
# (lib/vercel-analytics.ts). Token: Vercel Dashboard → Account Settings →
# Tokens. Project ID: Vercel Dashboard → your project → Settings → General.
# Team ID is only needed if the project lives under a team — omit it for a
# personal account. You must also click "Enable" under your project's
# Analytics tab in the Vercel dashboard, separately from these vars, or the
# public site's <Analytics /> script has nothing to report into. With none
# of this set, the dashboard section shows a "Connect Vercel Analytics"
# prompt instead of breaking.
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
