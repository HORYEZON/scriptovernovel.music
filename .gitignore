# ─── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Yarn (Berry) ────────────────────────────────────────────
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.cjs
.pnp.loader.mjs

# ─── Next.js ─────────────────────────────────────────────────
.next/
out/
build/

# ─── Environment Variables ───────────────────────────────────
# Never commit these — they contain secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Prisma ──────────────────────────────────────────────────
# Keep schema.prisma and migrations, ignore generated client
prisma/dev.db
prisma/dev.db-journal

# ─── Logs ────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── OS Files ────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editor / IDE ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Misc ────────────────────────────────────────────────────
.vercel
.turbo
coverage/
rollback-media-urls-*.json

# ─── Supabase (local CLI) ────────────────────────────────────────
supabase/.temp/
supabase/.branches/
